# =============================================================================
# KnowOps — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=KnowOps
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://knowops:knowops@localhost:5432/knowops
TEST_DATABASE_URL=postgresql+asyncpg://knowops:knowops@localhost:5432/knowops_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=knowops
MINIO_SECRET_KEY=knowops123
MINIO_BUCKET=knowops-documents
MINIO_USE_SSL=false

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- LLM (Groq) ---
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0
LLM_REQUEST_TIMEOUT=60

# --- Embeddings ---
# local  -> fastembed, downloads the model on first use (no API key needed)
# openai -> any OpenAI-compatible /embeddings endpoint (set BASE_URL + API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Where the local model is cached. docker-compose sets /app/.cache/fastembed.
# EMBEDDING_CACHE_DIR=

# --- Chunking & Retrieval ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.2
CHAT_HISTORY_LIMIT=10

# --- Knowledge quality scan ---
STALE_DOCUMENT_DAYS=180
CONFLICT_SIMILARITY_THRESHOLD=0.78
CONFLICT_MAX_PAIRS=12

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv
